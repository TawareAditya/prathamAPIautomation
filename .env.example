# Copy to .env (gitignored) and fill in to enable the DB verification tests.
# Use a READ-ONLY database user. The tests only ever run SELECTs.
# Without these, tests/api/test_db_verification.py skips and the rest of the
# suite runs normally.

POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DATABASE=pratham
POSTGRES_USERNAME=
POSTGRES_PASSWORD=
